{
  "name": "cheers-across",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,party -c yellow,cyan \"npm:dev:next\" \"npm:dev:party\"",
    "dev:next": "next dev",
    "dev:party": "wrangler dev --config party/wrangler.jsonc --ip 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p party/tsconfig.json",
    "party:types": "wrangler types party/worker-configuration.d.ts --config party/wrangler.jsonc",
    "party:deploy": "wrangler deploy --config party/wrangler.jsonc"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@upstash/redis": "^1.38.4",
    "@vercel/blob": "^2.8.0",
    "next": "16.3.5",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.131.2"
  }
}
