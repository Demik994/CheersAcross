# Sve varijable su opcionalne za lokalni razvoj (`npm run dev`):
# bez njih se sobe drže u memoriji dev servera, slike u .local-uploads/,
# a real-time server radi lokalno na portu 1999 sa zadanom dev tajnom.
#
# NE UVOZI ovu datoteku na Vercel s praznim vrijednostima — prazna varijabla može
# "prekriti" onu koju automatski postavlja Vercel Storage integracija.
# Zato su ovdje namjerno zakomentirane.

# Upstash Redis — postavlja Vercel Storage integracija (KV_REST_API_URL / KV_REST_API_TOKEN).
# Ručna Upstash konfiguracija bez Vercela:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (store s "public" pristupom) — postavlja Vercel Storage integracija.
# BLOB_READ_WRITE_TOKEN=

# Real-time server (PartyServer na Cloudflare Workersima, folder party/) — dodaj ručno na Vercelu.
# Ista tajna mora biti u Workeru: npx wrangler secret put PARTY_SECRET --config party/wrangler.jsonc
# PARTY_SECRET=
# Adresa Workera, npr. https://cheers-across-party.<racun>.workers.dev
# PARTY_URL=
# Opcionalno: host za preglednike, ako se razlikuje od hosta iz PARTY_URL
# PARTY_PUBLIC_HOST=
