# Sve varijable su opcionalne za lokalni razvoj (`npm run dev`):
# bez njih se sobe drže u memoriji dev servera, a slike u .local-uploads/.
# U produkciji (Vercel) su obje obavezne.

# Upstash Redis — sobe i gosti (ističu 24 h nakon kreiranja sobe).
# Vercel Marketplace integracija postavlja KV_REST_API_URL / KV_REST_API_TOKEN — i to radi.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob — slika razloga slavlja (store mora imati "public" pristup).
BLOB_READ_WRITE_TOKEN=
