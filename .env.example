# Sve varijable su opcionalne za lokalni razvoj (`npm run dev`):
# bez njih se sobe drže u memoriji dev servera, slike u .local-uploads/,
# a real-time server radi lokalno na portu 1999 sa zadanom dev tajnom.
# U produkciji (Vercel) su sve obavezne.

# Upstash Redis — sobe i gosti (ističu 24 h nakon kreiranja sobe).
# Vercel Marketplace integracija postavlja KV_REST_API_URL / KV_REST_API_TOKEN — i to radi.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob — slika razloga slavlja (store mora imati "public" pristup).
BLOB_READ_WRITE_TOKEN=

# Real-time server (PartyServer na Cloudflare Workersima, folder party/)
# Ista tajna mora biti postavljena i u Workeru: npx wrangler secret put PARTY_SECRET --config party/wrangler.jsonc
PARTY_SECRET=
# Adresa Workera za Next.js (server -> server), npr. https://cheers-across-party.<racun>.workers.dev
PARTY_URL=
# Host na koji se spajaju preglednici; zadano je host iz PARTY_URL
PARTY_PUBLIC_HOST=
