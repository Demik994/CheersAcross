{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["./worker-configuration.d.ts"],
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts", "../src/lib/party/protocol.ts", "../src/lib/party/ticket.ts", "../src/lib/party/geometry.ts", "../src/lib/drinks.ts", "../src/lib/drunk.ts"]
}
