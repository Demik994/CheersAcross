# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# lokalni upload slika (razvoj bez Vercel Bloba)
/.local-uploads

# osobne Claude Code postavke
.claude/settings.local.json

# Cloudflare Wrangler (lokalno stanje i tajne)
.wrangler/
party/.wrangler/
party/.dev.vars
